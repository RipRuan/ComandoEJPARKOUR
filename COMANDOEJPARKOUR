-- SISTEMA DAS PLATAFORMAS
-- ==============================================
local function CriarPlataformas()
    for _, dados in ipairs(LocalData) do
        local Plataforma = Instance.new("Part")
        Plataforma.Position = dados.pos
        Plataforma.Size = dados.size
        Plataforma.Anchored = true
        Plataforma.CanCollide = true
        Plataforma.Transparency = 0.3
        Plataforma.Color = Color3.new(0.6, 0, 1)
        Plataforma.Parent = workspace

        -- BORDA
        local Borda = Instance.new("SelectionBox")
        Borda.Adornee = Plataforma
        Borda.Color3 = Color3.new(0, 0, 0)
        Borda.LineThickness = 0.05
        Borda.Parent = Plataforma

        table.insert(Plataformas, Plataforma)
    end
end

local function RemoverPlataformas()
    for _, v in pairs(Plataformas) do
        v:Destroy()
    end
    Plataformas = {}
end

-- TELEPORTE
local function TeleportarParaPlataforma()
    if not Ativado or #Plataformas == 0 then return end
    
    local playerPos = HumanoidRootPart.Position
    local maisProxima = nil
    local menorDistancia = math.huge
    
    for _, plataforma in ipairs(Plataformas) do
        local dist = (playerPos - plataforma.Position).Magnitude
        if dist < menorDistancia then
            menorDistancia = dist
            maisProxima = plataforma
        end
    end
    
    if maisProxima and menorDistancia > 5 then
        local novaPos = maisProxima.Position + Vector3.new(0, 3, 0)
        HumanoidRootPart.CFrame = CFrame.new(novaPos)
    end
end

-- LOOP DE TELEPORTE
RunService.Heartbeat:Connect(function()
    if Ativado then
        TeleportarParaPlataforma()
    end
end)

-- AÇÃO DO BOTÃO
Botao.MouseButton1Click:Connect(function()
    Ativado = not Ativado
    if Ativado then
        CriarPlataformas()
        Botao.Text = "DESATIVAR PARKOUR"
        Botao.BackgroundColor3 = Color3.new(0.7, 0, 0.2)
    else
        RemoverPlataformas()
        Botao.Text = "ATIVAR PARKOUR"
        Botao.BackgroundColor3 = Color3.new(0.2, 0, 0.7)
    end
end)

